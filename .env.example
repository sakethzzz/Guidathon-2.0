# Copy to .env and fill values locally. Never commit real credentials.
NODE_ENV=development
PORT=3000

# MySQL persistence (required for persistent workspaces and RAG)
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE

# Manus OAuth/session (required for sign-in and protected persistence routes)
MANUS_PROJECT_ID=your-project-id
MANUS_JWT_SECRET=replace-with-a-long-random-secret
MANUS_OAUTH_API_URL=https://your-manus-oauth-api
OWNER_OPEN_ID=

# Model providers (at least one provider is needed for live agent responses)
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Free fallback (create a free OpenRouter API key; defaults to its free-model router)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Optional managed-model fallback
MANUS_API_URL=
MANUS_API_KEY=

# Optional external MCP bridge (remote endpoints must use HTTPS)
MCP_SERVER_URL=
MCP_SERVER_TOKEN=
